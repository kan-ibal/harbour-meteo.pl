#: native/qml/pages/AboutPage.qml:19
msgid "harbour-meteopl client"
msgstr "harbour-meteopl client"

#: native/qml/pages/AboutPage.qml:43
msgid ""
"Natywny klient meteogramów dla systemu Sailfish OS. Pozwala pobierać, "
"przeglądać i lokalnie zapisywać (cache) prognozy numeryczne ICM UM 4 km z "
"portalu old.meteo.pl."
msgstr ""
"Native meteogram client for Sailfish OS. Allows fetching, viewing, and "
"locally caching ICM UM 4 km numerical forecasts from the old.meteo.pl portal."

